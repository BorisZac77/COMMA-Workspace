<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Assets/Icons/Pimp.ico</ApplicationIcon>

        <Version>4.0.0</Version>
        <AssemblyVersion>4.0.0.0</AssemblyVersion>
        <FileVersion>4.0.0.0</FileVersion>
        <InformationalVersion>4.0.0</InformationalVersion>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets/**" />
    </ItemGroup>

    <ItemGroup>
        <None Update="Assets/Branding/**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </None>

        <None Update="Assets/Templates/**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia"
                          Version="12.1.1" />

        <PackageReference Include="Avalonia.Desktop"
                          Version="12.1.1" />

        <PackageReference Include="Avalonia.Themes.Fluent"
                          Version="12.1.1" />

        <PackageReference Include="Avalonia.Fonts.Inter"
                          Version="12.1.1" />

        <PackageReference Include="AvaloniaUI.DiagnosticsSupport"
                          Version="2.2.3">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">
                None
            </IncludeAssets>

            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">
                All
            </PrivateAssets>
        </PackageReference>

        <PackageReference Include="CommunityToolkit.Mvvm"
                          Version="8.4.2" />

        <PackageReference Include="QuestPDF"
                          Version="2025.12.4" />

        <PackageReference Include="PdfPig"
                          Version="0.1.15" />

        <PackageReference Include="PDFsharp"
                          Version="6.2.4" />

        <PackageReference Include="PDFtoImage"
                          Version="5.2.1" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Assets/Branding/" />
        <Folder Include="Assets/Icons/" />
        <Folder Include="Resources/" />
        <Folder Include="Styles/" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../COMMA.Core/COMMA.Core.csproj" />
    </ItemGroup>

</Project>
