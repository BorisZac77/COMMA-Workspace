<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="COMMA.App.Controls.DrawingBox"
             x:Name="Root">

    <Border Background="White"
            BorderBrush="#111111"
            BorderThickness="1"
            Padding="8">

        <Grid RowDefinitions="Auto,*">

            <TextBlock Grid.Row="0"
                       HorizontalAlignment="Center"
                       FontSize="11"
                       FontWeight="Bold"
                       Text="{Binding Title, ElementName=Root}"/>

            <Image x:Name="DrawingImage"
                   Grid.Row="1"
                   Margin="8,14,8,8"
                   Stretch="Uniform"
                   MaxWidth="{Binding MaxDrawingWidth, ElementName=Root}"
                   MaxHeight="{Binding MaxDrawingHeight, ElementName=Root}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   RenderTransformOrigin="50%,50%">

                <Image.RenderTransform>
                    <ScaleTransform ScaleX="{Binding ScaleX, ElementName=Root}"
                                    ScaleY="1"/>
                </Image.RenderTransform>

            </Image>

        </Grid>

    </Border>

</UserControl>