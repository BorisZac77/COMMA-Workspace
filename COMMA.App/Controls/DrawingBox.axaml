<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="COMMA.App.Controls.DrawingBox"
             x:Name="Root">

    <Border Background="White"
            BorderBrush="#111111"
            BorderThickness="1"
            Padding="8">

        <Grid RowDefinitions="Auto,*">

            <TextBlock Grid.Row="0"
                       HorizontalAlignment="Center"
                       FontSize="11"
                       FontWeight="Bold"
                       Text="{Binding Title, ElementName=Root}"/>

            <StackPanel x:Name="DrawingContentPanel"
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top">

                <Image x:Name="DrawingImage"
                       Margin="8,14,8,2"
                       Stretch="Uniform"
                       MaxWidth="{Binding MaxDrawingWidth, ElementName=Root}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       RenderTransformOrigin="50%,50%">

                    <Image.RenderTransform>
                        <ScaleTransform ScaleX="{Binding ScaleX, ElementName=Root}"
                                        ScaleY="1"/>
                    </Image.RenderTransform>

                </Image>

                <TextBlock x:Name="DescriptionTextBlock"
                            Margin="6,1,6,2"
                            HorizontalAlignment="Stretch"
                           TextAlignment="Left"
                           TextWrapping="Wrap"
                           TextTrimming="None"
                            Text="{Binding Description, ElementName=Root}"
                           FontSize="{Binding DescriptionFontSize, ElementName=Root}"/>

            </StackPanel>

        </Grid>

    </Border>

</UserControl>
