<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:COMMA.App.ViewModels"
             xmlns:models="using:COMMA.App.Models"
             xmlns:controls="using:COMMA.App.Controls"
             xmlns:converters="using:COMMA.App.Converters"
             x:Class="COMMA.App.Controls.ProductionCardPreview"
             x:DataType="vm:MainViewModel">

    <UserControl.Resources>
        <converters:OrderHeaderTextValueConverter
            x:Key="OrderHeaderTextValueConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>

        <Style Selector="TextBlock.placeholder">
            <Setter Property="Foreground"
                    Value="#9A9DA2"/>
        </Style>

        <Style Selector="TextBlock.orderNamePlaceholder">
            <Setter Property="FontSize"
                    Value="13"/>
        </Style>

        <Style Selector="TextBlock.orderNameValue">
            <Setter Property="Foreground"
                    Value="#0071BC"/>
        </Style>

    </UserControl.Styles>


    <Border Background="#E8E9EB"
            Padding="14">

        <Grid RowDefinitions="*,34">

            <!-- ================================================= -->
            <!-- PODGLĄD STRONY A4 -->
            <!-- ================================================= -->

            <Viewbox Grid.Row="0"
                     Stretch="Uniform"
                     IsVisible="{Binding IsProductionCardPreviewPage}">

                <Grid Width="620"
                      Height="877">

                    <Border Background="White"
                            BorderBrush="#111111"
                            BorderThickness="1"
                            Padding="6">

                        <Grid RowDefinitions="Auto,*">

                            <!-- ================================================= -->
                            <!-- PREAMBUŁA STRONY 1 -->
                            <!-- ================================================= -->

                            <Grid Grid.Row="0"
                                  RowDefinitions="74,3,18,38,18,98,3"
                                  IsVisible="{Binding PreviewPage.IsFirstPage,
                                                      TargetNullValue=True,
                                                      FallbackValue=True}">

                            <!-- NAGŁÓWEK -->
                            <Grid Grid.Row="0"
                                  RowDefinitions="44,30"
                                  ColumnDefinitions="155,*,*,*">

                                <!-- LOGO -->
                                <Border Grid.Row="0"
                                        Grid.RowSpan="2"
                                        Grid.Column="0"
                                        BorderBrush="#111111"
                                        BorderThickness="1"
                                        Padding="5">

                                    <Image Source="/Assets/Branding/PimpLogoExact.png"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="10,1"/>

                                </Border>


                                <!-- NUMER / NAZWA ZLECENIA / NUMER STRONY -->
                                <Grid Grid.Row="0"
                                      Grid.Column="1"
                                      Grid.ColumnSpan="3"
                                      ColumnDefinitions="108.3,*,70">

                                    <Border Grid.Column="0"
                                            BorderBrush="#111111"
                                            BorderThickness="0,1,1,1"
                                            Padding="6.25,2">

                                        <Grid RowDefinitions="8,*">

                                            <TextBlock Grid.Row="0"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="5.5"
                                                       FontWeight="Bold"
                                                       Text="NUMER ZLECENIA"/>

                                            <TextBlock x:Name="FirstOrderNumberValue"
                                                       Grid.Row="1"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Center"
                                                       TextWrapping="NoWrap"
                                                       MaxLines="1"
                                                       FontSize="{Binding ProductionCard.OrderNumber,
                                                           Converter={StaticResource OrderHeaderTextValueConverter},
                                                           ConverterParameter=FirstNumberFontSize}"
                                                       FontWeight="Bold"
                                                       Classes="orderNameValue"
                                                       Text="{Binding ProductionCard.OrderNumber,
                                                           Converter={StaticResource OrderHeaderTextValueConverter},
                                                           ConverterParameter=FirstNumberText}"/>

                                        </Grid>

                                    </Border>

                                    <Border Grid.Column="1"
                                            BorderBrush="#111111"
                                            BorderThickness="0,1,1,1"
                                            Padding="6.25,2">

                                        <Grid RowDefinitions="8,*">

                                            <TextBlock Grid.Row="0"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="5.5"
                                                       FontWeight="Bold"
                                                       Text="NAZWA ZLECENIA"/>

                                            <TextBlock x:Name="FirstOrderNameValue"
                                                       Grid.Row="1"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Center"
                                                       TextWrapping="NoWrap"
                                                       MaxLines="2"
                                                       LineHeight="{Binding ProductionCard.PreviewOrderName,
                                                           Converter={StaticResource OrderHeaderTextValueConverter},
                                                           ConverterParameter=FirstNameLineHeight}"
                                                       FontSize="{Binding ProductionCard.PreviewOrderName,
                                                           Converter={StaticResource OrderHeaderTextValueConverter},
                                                           ConverterParameter=FirstNameFontSize}"
                                                       FontWeight="Bold"
                                                       Classes.placeholder="{Binding ProductionCard.IsOrderNameEmpty}"
                                                       Classes.orderNamePlaceholder="{Binding ProductionCard.IsOrderNameEmpty}"
                                                       Classes.orderNameValue="{Binding !ProductionCard.IsOrderNameEmpty}"
                                                       Text="{Binding ProductionCard.PreviewOrderName,
                                                           Converter={StaticResource OrderHeaderTextValueConverter},
                                                           ConverterParameter=FirstNameText}"/>

                                        </Grid>

                                    </Border>

                                    <Border Grid.Column="2"
                                            BorderBrush="#111111"
                                            BorderThickness="0,1,1,1"
                                            Padding="2">

                                        <Grid RowDefinitions="8,*">

                                            <TextBlock Grid.Row="0"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="5.5"
                                                       FontWeight="Bold"
                                                       Text="STRONA"/>

                                            <TextBlock x:Name="FirstPageNumberValue"
                                                       Grid.Row="1"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Center"
                                                       FontSize="13"
                                                       FontWeight="Bold"
                                                       Text="{Binding PreviewPage.PageNumberText}"/>

                                        </Grid>

                                    </Border>

                                </Grid>


                                <!-- KLIENT -->
                                <Border Grid.Row="1"
                                        Grid.Column="1"
                                        BorderBrush="#111111"
                                        BorderThickness="0,0,1,1"
                                        Padding="2">

                                    <Grid RowDefinitions="10,*">

                                        <TextBlock Grid.Row="0"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="6.5"
                                                   FontWeight="Bold"
                                                   Text="KLIENT"/>

                                        <Viewbox Grid.Row="1"
                                                 Stretch="Uniform"
                                                 StretchDirection="DownOnly"
                                                 Margin="5,0">

                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Center"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Classes.placeholder="{Binding ProductionCard.IsCustomerEmpty}"
                                                       Text="{Binding ProductionCard.PreviewCustomer}"/>

                                        </Viewbox>

                                    </Grid>

                                </Border>


                                <!-- TERMIN -->
                                <Border Grid.Row="1"
                                        Grid.Column="2"
                                        BorderBrush="#111111"
                                        BorderThickness="0,0,1,1"
                                        Padding="2">

                                    <Grid RowDefinitions="10,*">

                                        <TextBlock Grid.Row="0"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="6.5"
                                                   FontWeight="Bold"
                                                   Text="TERMIN WYKONANIA"/>

                                        <Viewbox Grid.Row="1"
                                                 Stretch="Uniform"
                                                 StretchDirection="DownOnly"
                                                 Margin="5,0">

                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Center"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Classes.placeholder="{Binding ProductionCard.IsDueDateEmpty}"
                                                       Text="{Binding ProductionCard.PreviewDueDate}"/>

                                        </Viewbox>

                                    </Grid>

                                </Border>


                                <!-- RODZAJ PRODUKCJI -->
                                <Border Grid.Row="1"
                                        Grid.Column="3"
                                        BorderBrush="#111111"
                                        BorderThickness="0,0,1,1"
                                        Padding="2">

                                    <Grid RowDefinitions="10,*">

                                        <TextBlock Grid.Row="0"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="6.5"
                                                   FontWeight="Bold"
                                                   Text="RODZAJ PRODUKCJI"/>

                                        <Viewbox Grid.Row="1"
                                                 Stretch="Uniform"
                                                 StretchDirection="DownOnly"
                                                 Margin="5,0">

                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Center"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Classes.placeholder="{Binding ProductionCard.IsProductionTypeEmpty}"
                                                       Text="{Binding ProductionCard.PreviewProductionType}"/>

                                        </Viewbox>

                                    </Grid>

                                </Border>

                            </Grid>


                            <Border Grid.Row="1"/>


                            <!-- LOGOWANIE -->
                            <Border Grid.Row="2"
                                    BorderBrush="#111111"
                                    BorderThickness="1">

                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"
                                           FontSize="8"
                                           FontWeight="Black"
                                           Text="LOGOWANIE (NAZWA WZORU / WYMIAR)"/>

                            </Border>


                            <ItemsControl Grid.Row="3"
                                          ItemsSource="{Binding ProductionCard.ProductionEntries}">

                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>

                                        <UniformGrid Columns="4"
                                                     Rows="1"/>

                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate x:DataType="models:ProductionEntry">

                                        <Border BorderBrush="#111111"
                                                BorderThickness="1,0,1,1"
                                                Padding="3">

                                            <Grid IsVisible="{Binding HasContent}"
                                                  RowDefinitions="17,*"
                                                  ColumnDefinitions="19,*">

                                                <Border Grid.Row="0"
                                                        Grid.Column="0"
                                                        Width="14"
                                                        Height="14"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        BorderBrush="#111111"
                                                        BorderThickness="0.7"
                                                        CornerRadius="7">

                                                    <TextBlock HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontSize="7"
                                                               FontWeight="Bold"
                                                               Text="{Binding Number}"/>

                                                </Border>

                                                <Viewbox Grid.Row="0"
                                                         Grid.Column="1"
                                                         Stretch="Uniform"
                                                         StretchDirection="DownOnly"
                                                         HorizontalAlignment="Left">

                                                    <TextBlock VerticalAlignment="Center"
                                                               TextWrapping="NoWrap"
                                                               FontSize="10"
                                                               FontWeight="Black"
                                                               Text="{Binding LogoName}"/>

                                                </Viewbox>

                                                <Viewbox Grid.Row="1"
                                                         Grid.Column="1"
                                                         Stretch="Uniform"
                                                         StretchDirection="DownOnly"
                                                         HorizontalAlignment="Left">

                                                    <TextBlock VerticalAlignment="Top"
                                                               TextWrapping="NoWrap"
                                                               FontSize="7.5"
                                                               FontWeight="Bold"
                                                               Text="{Binding Dimension}"/>

                                                </Viewbox>

                                            </Grid>

                                        </Border>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>


                            <!-- KOLORYSTYKA -->
                            <Border Grid.Row="4"
                                    BorderBrush="#111111"
                                    BorderThickness="1">

                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"
                                           FontSize="8"
                                           FontWeight="Black"
                                           Text="KOLORYSTYKA (KOLOR / NICI)"/>

                            </Border>


                            <ItemsControl Grid.Row="5"
                                          ItemsSource="{Binding ProductionCard.ProductionEntries}">

                                <ItemsControl.ItemsPanel>

                                    <ItemsPanelTemplate>

                                        <UniformGrid Columns="4"
                                                     Rows="1"/>

                                    </ItemsPanelTemplate>

                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate x:DataType="models:ProductionEntry">

                                        <Border BorderBrush="#111111"
                                                BorderThickness="1,0,1,1"
                                                Padding="5,3">

                                            <ItemsControl ItemsSource="{Binding Colours}"
                                                          VerticalAlignment="Top">

                                                <ItemsControl.ItemsPanel>

                                                    <ItemsPanelTemplate>

                                                        <StackPanel Spacing="0"/>

                                                    </ItemsPanelTemplate>

                                                </ItemsControl.ItemsPanel>

                                                <ItemsControl.ItemTemplate>

                                                    <DataTemplate x:DataType="models:ProductionColourEntry">

                                                        <Grid Height="11"
                                                              ColumnDefinitions="20,*">

                                                            <TextBlock Grid.Column="0"
                                                                       HorizontalAlignment="Left"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="7"
                                                                       FontWeight="Bold"
                                                                       Text="{Binding Number, StringFormat={}{0}.}"/>

                                                            <Viewbox Grid.Column="1"
                                                                     Stretch="Uniform"
                                                                     StretchDirection="DownOnly"
                                                                     HorizontalAlignment="Left">

                                                                <TextBlock VerticalAlignment="Center"
                                                                           TextWrapping="NoWrap"
                                                                           FontSize="7.5"
                                                                           Text="{Binding Value}"/>

                                                            </Viewbox>

                                                        </Grid>

                                                    </DataTemplate>

                                                </ItemsControl.ItemTemplate>

                                            </ItemsControl>

                                        </Border>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>


                                <Border Grid.Row="6"/>

                            </Grid>


                            <!-- ================================================= -->
                            <!-- PREAMBUŁA STRON 2 I KOLEJNYCH -->
                            <!-- ================================================= -->

                            <Grid Grid.Row="0"
                                  RowDefinitions="74,6"
                                  IsVisible="{Binding !PreviewPage.IsFirstPage,
                                                      TargetNullValue=False,
                                                      FallbackValue=False}">

                            <!-- NAGŁÓWEK KONTYNUACYJNY -->
                            <Grid x:Name="ContinuationHeader"
                                  Grid.Row="0"
                                  ColumnDefinitions="155,108.3,*,70">

                                <!-- LOGO -->
                                <Border Grid.Column="0"
                                        BorderBrush="#111111"
                                        BorderThickness="1"
                                        Padding="5">

                                    <Image Source="/Assets/Branding/PimpLogoExact.png"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="10,1"/>

                                </Border>


                                <!-- NUMER ZLECENIA -->
                                <Border Grid.Column="1"
                                        BorderBrush="#111111"
                                        BorderThickness="0,1,1,1"
                                        Padding="6.25,2">

                                    <Grid RowDefinitions="8,*">

                                        <TextBlock Grid.Row="0"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="5.5"
                                                   FontWeight="Bold"
                                                   Text="NUMER ZLECENIA"/>

                                        <TextBlock x:Name="ContinuationOrderNumberValue"
                                                   Grid.Row="1"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center"
                                                   TextWrapping="NoWrap"
                                                   MaxLines="1"
                                                   FontSize="{Binding ProductionCard.OrderNumber,
                                                       Converter={StaticResource OrderHeaderTextValueConverter},
                                                       ConverterParameter=LaterNumberFontSize}"
                                                   FontWeight="Bold"
                                                   Classes="orderNameValue"
                                                   Text="{Binding ProductionCard.OrderNumber,
                                                       Converter={StaticResource OrderHeaderTextValueConverter},
                                                       ConverterParameter=LaterNumberText}"/>

                                    </Grid>

                                </Border>


                                <!-- NAZWA ZLECENIA -->
                                <Border Grid.Column="2"
                                        BorderBrush="#111111"
                                        BorderThickness="0,1,1,1"
                                        Padding="6.25,2">

                                    <Grid RowDefinitions="8,*">

                                        <TextBlock Grid.Row="0"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="5.5"
                                                   FontWeight="Bold"
                                                   Text="NAZWA ZLECENIA"/>

                                        <TextBlock x:Name="ContinuationOrderNameValue"
                                                   Grid.Row="1"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center"
                                                   TextWrapping="NoWrap"
                                                   MaxLines="2"
                                                   LineHeight="{Binding ProductionCard.PreviewOrderName,
                                                       Converter={StaticResource OrderHeaderTextValueConverter},
                                                       ConverterParameter=LaterNameLineHeight}"
                                                   FontSize="{Binding ProductionCard.PreviewOrderName,
                                                       Converter={StaticResource OrderHeaderTextValueConverter},
                                                       ConverterParameter=LaterNameFontSize}"
                                                   FontWeight="Bold"
                                                   Classes.placeholder="{Binding ProductionCard.IsOrderNameEmpty}"
                                                   Classes.orderNamePlaceholder="{Binding ProductionCard.IsOrderNameEmpty}"
                                                   Classes.orderNameValue="{Binding !ProductionCard.IsOrderNameEmpty}"
                                                   Text="{Binding ProductionCard.PreviewOrderName,
                                                       Converter={StaticResource OrderHeaderTextValueConverter},
                                                       ConverterParameter=LaterNameText}"/>

                                    </Grid>

                                </Border>


                                <!-- NUMER STRONY -->
                                <Border Grid.Column="3"
                                        BorderBrush="#111111"
                                        BorderThickness="0,1,1,1"
                                        Padding="2">

                                    <Grid RowDefinitions="8,*">

                                        <TextBlock Grid.Row="0"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="5.5"
                                                   FontWeight="Bold"
                                                   Text="STRONA"/>

                                        <TextBlock x:Name="ContinuationPageNumberValue"
                                                   Grid.Row="1"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Text="{Binding PreviewPage.PageNumberText}"/>

                                    </Grid>

                                </Border>

                            </Grid>


                                <Border Grid.Row="1"/>

                            </Grid>


                            <!-- WSPÓLNA POWIERZCHNIA NA ODZIEŻ -->
                            <Grid Grid.Row="1">

                                <controls:GarmentPageSection
                                    Page="{Binding PreviewPage}"/>

                            </Grid>

                        </Grid>

                    </Border>

                </Grid>

            </Viewbox>

            <Viewbox Grid.Row="0"
                     Stretch="Uniform"
                     IsVisible="{Binding IsAttachmentPreviewPage}">

                <Border Width="{Binding PreviewAttachmentPageWidth}"
                        Height="{Binding PreviewAttachmentPageHeight}"
                        Background="White"
                        BorderBrush="#111111"
                        BorderThickness="1">

                    <Image Source="{Binding PreviewAttachmentImage}"
                           Stretch="Uniform"/>

                </Border>

            </Viewbox>


            <!-- ================================================= -->
            <!-- NAWIGACJA STRON PODGLĄDU -->
            <!-- ================================================= -->

            <Grid Grid.Row="1"
                  ColumnDefinitions="*,Auto,Auto,Auto,*"
                  ColumnSpacing="10"
                  VerticalAlignment="Center">

                <Button Grid.Column="1"
                        Width="34"
                        Height="26"
                        Padding="0"
                        FontSize="14"
                        FontWeight="Bold"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Content="◀"
                        Command="{Binding PreviousPreviewPageCommand}"
                        IsEnabled="{Binding CanGoToPreviousPreviewPage}"/>

                <TextBlock Grid.Column="2"
                           MinWidth="54"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#3F4348"
                           Text="{Binding PreviewPageNumberText}"/>

                <Button Grid.Column="3"
                        Width="34"
                        Height="26"
                        Padding="0"
                        FontSize="14"
                        FontWeight="Bold"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Content="▶"
                        Command="{Binding NextPreviewPageCommand}"
                        IsEnabled="{Binding CanGoToNextPreviewPage}"/>

            </Grid>

        </Grid>

    </Border>

</UserControl>
