<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:COMMA.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="COMMA.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1600"
        Height="900"
        Title="COMMA Workspace">

    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <DockPanel Margin="20">

        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Spacing="10"
                    Margin="0,0,0,20">

            <Button Width="180"
                    Content="Open Library"
                    Command="{Binding OpenLibraryCommand}" />

            <Button Width="180"
                    Content="Generate PDF"
                    Command="{Binding GeneratePdfCommand}" />

            <TextBlock VerticalAlignment="Center"
                       Text="{Binding LibraryPath}" />

        </StackPanel>

        <Grid ColumnDefinitions="300,300,*"
              ColumnSpacing="15">

            <Border Grid.Column="0"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    Padding="10">

                <ListBox ItemsSource="{Binding Products}"
                         SelectedItem="{Binding SelectedProduct}" />

            </Border>

            <Border Grid.Column="1"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    Padding="10">

                <ListBox ItemsSource="{Binding Drawings}"
                         SelectedItem="{Binding SelectedDrawing}" />

            </Border>

            <Border Grid.Column="2"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    Padding="10">

                <ScrollViewer>

                    <Image Source="{Binding SelectedImage}"
                           Stretch="Uniform" />

                </ScrollViewer>

            </Border>

        </Grid>

    </DockPanel>

</Window>