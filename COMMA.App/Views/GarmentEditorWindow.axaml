<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="COMMA.App.Views.GarmentEditorWindow"
        Width="720"
        Height="780"
        MinWidth="720"
        MinHeight="780"
        MaxWidth="720"
        MaxHeight="780"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Odzież w zleceniu">

    <Window.Styles>
        <Style Selector="Border#HeaderPanel">
            <Setter Property="Padding" Value="24,20"/>
        </Style>

        <Style Selector="StackPanel#FormPanel">
            <Setter Property="Margin" Value="24"/>
            <Setter Property="Spacing" Value="18"/>
        </Style>

        <Style Selector="TextBox.form-field">
            <Setter Property="MinHeight" Value="40"/>
        </Style>

        <Style Selector="TextBox.view-description-field">
            <Setter Property="MinHeight" Value="64"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style Selector="Border.form-section">
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style Selector="Border#FooterPanel">
            <Setter Property="Padding" Value="24,16"/>
        </Style>

        <Style Selector="Button.footer-button">
            <Setter Property="Height" Value="44"/>
        </Style>

        <Style Selector="Window.windows-compact Border#HeaderPanel">
            <Setter Property="Padding" Value="18,14"/>
        </Style>

        <Style Selector="Window.windows-compact StackPanel#FormPanel">
            <Setter Property="Margin" Value="18"/>
            <Setter Property="Spacing" Value="12"/>
        </Style>

        <Style Selector="Window.windows-compact TextBox.form-field">
            <Setter Property="MinHeight" Value="36"/>
        </Style>

        <Style Selector="Window.windows-compact TextBox.view-description-field">
            <Setter Property="MinHeight" Value="58"/>
        </Style>

        <Style Selector="Window.windows-compact Border.form-section">
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style Selector="Window.windows-compact Border#FooterPanel">
            <Setter Property="Padding" Value="18,12"/>
        </Style>

        <Style Selector="Window.windows-compact Button.footer-button">
            <Setter Property="Height" Value="40"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto"
          Background="#F4F5F7">

        <!-- NAGŁÓWEK -->
        <Border x:Name="HeaderPanel"
                Grid.Row="0"
                Background="White"
                BorderBrush="#D8DADF"
                BorderThickness="0,0,0,1">

            <StackPanel Spacing="4">

                <TextBlock Text="ODZIEŻ W ZLECENIU"
                           FontSize="22"
                           FontWeight="Bold"/>

                <TextBlock Text="Ustaw wariant produktu oraz wybierz rzuty potrzebne na karcie."
                           FontSize="12"
                           Foreground="#6F737A"
                           TextWrapping="Wrap"/>

            </StackPanel>

        </Border>

        <!-- ZAWARTOŚĆ -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel x:Name="FormPanel">

                <!-- NAZWA -->
                <StackPanel Spacing="5">

                    <TextBlock Text="NAZWA ODZIEŻY"
                               FontSize="11"
                               FontWeight="Bold"/>

                    <TextBox x:Name="GarmentNameTextBox"
                             Classes="form-field"
                             IsReadOnly="True"/>

                    <TextBlock Text="Nazwa jest pobierana z wybranego produktu w bibliotece."
                               FontSize="10"
                               Foreground="#6F737A"
                               TextWrapping="Wrap"/>

                </StackPanel>

                <!-- KOLOR -->
                <StackPanel Spacing="5">

                    <TextBlock Text="KOLOR"
                               FontSize="11"
                               FontWeight="Bold"/>

                    <TextBox x:Name="ColourTextBox"
                             Classes="form-field"
                             PlaceholderText="Opcjonalnie, np. CZARNY"/>

                </StackPanel>

                <!-- WARIANT -->
                <StackPanel Spacing="5">

                    <TextBlock Text="WARIANT / OPIS"
                               FontSize="11"
                               FontWeight="Bold"/>

                    <TextBox x:Name="VariantTextBox"
                             Classes="form-field"
                             PlaceholderText="Opcjonalnie, np. STAFF"/>

                </StackPanel>

                <!-- RZUTY -->
                <Border Classes="form-section"
                        Background="White"
                        BorderBrush="#D8DADF"
                        BorderThickness="1"
                        CornerRadius="7">

                    <StackPanel Spacing="12">

                        <TextBlock Text="RZUTY NA KARCIE"
                                   FontSize="11"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Wybierz tylko rzuty potrzebne dla tej pozycji."
                                   FontSize="10"
                                   Foreground="#6F737A"/>

                        <Grid ColumnDefinitions="*,*"
                              RowDefinitions="Auto,Auto"
                              ColumnSpacing="18"
                              RowSpacing="12">

                            <StackPanel Grid.Row="0"
                                        Grid.Column="0"
                                        Spacing="5">

                                <CheckBox x:Name="FrontCheckBox"
                                          Content="PRZÓD"/>

                                <TextBlock Text="OPIS RZUTU - FRONT"
                                           FontSize="9"
                                           FontWeight="SemiBold"/>

                                <TextBox x:Name="FrontDescriptionTextBox"
                                         Classes="view-description-field"
                                         PlaceholderText="Opcjonalny opis rzutu FRONT"/>

                            </StackPanel>

                            <StackPanel Grid.Row="0"
                                        Grid.Column="1"
                                        Spacing="5">

                                <CheckBox x:Name="BackCheckBox"
                                          Content="TYŁ"/>

                                <TextBlock Text="OPIS RZUTU - BACK"
                                           FontSize="9"
                                           FontWeight="SemiBold"/>

                                <TextBox x:Name="BackDescriptionTextBox"
                                         Classes="view-description-field"
                                         PlaceholderText="Opcjonalny opis rzutu BACK"/>

                            </StackPanel>

                            <StackPanel Grid.Row="1"
                                        Grid.Column="0"
                                        Spacing="5">

                                <CheckBox x:Name="RightCheckBox"
                                          Content="PRAWY BOK"/>

                                <TextBlock Text="OPIS RZUTU - RIGHT"
                                           FontSize="9"
                                           FontWeight="SemiBold"/>

                                <TextBox x:Name="RightDescriptionTextBox"
                                         Classes="view-description-field"
                                         PlaceholderText="Opcjonalny opis rzutu RIGHT"/>

                            </StackPanel>

                            <StackPanel Grid.Row="1"
                                        Grid.Column="1"
                                        Spacing="5">

                                <CheckBox x:Name="LeftCheckBox"
                                          Content="LEWY BOK"/>

                                <TextBlock Text="OPIS RZUTU - LEFT"
                                           FontSize="9"
                                           FontWeight="SemiBold"/>

                                <TextBox x:Name="LeftDescriptionTextBox"
                                         Classes="view-description-field"
                                         PlaceholderText="Opcjonalny opis rzutu LEFT"/>

                            </StackPanel>

                        </Grid>

                    </StackPanel>

                </Border>

                <!-- NOWA STRONA -->
                <Border Classes="form-section"
                        Background="White"
                        BorderBrush="#D8DADF"
                        BorderThickness="1"
                        CornerRadius="7">

                    <StackPanel Spacing="7">

                        <CheckBox x:Name="StartNewPageCheckBox"
                                  Content="ROZPOCZNIJ OD NOWEJ STRONY"
                                  FontWeight="SemiBold"/>

                        <TextBlock Text="Opcjonalnie wymusza rozpoczęcie tej pozycji od kolejnej strony PDF."
                                   Margin="24,0,0,0"
                                   FontSize="10"
                                   Foreground="#6F737A"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

        <!-- PRZYCISKI -->
        <Border x:Name="FooterPanel"
                Grid.Row="2"
                Background="White"
                BorderBrush="#D8DADF"
                BorderThickness="0,1,0,0">

            <Grid ColumnDefinitions="*,Auto,Auto"
                  ColumnSpacing="10">

                <Border Grid.Column="0"/>

                <Button x:Name="CancelButton"
                        Classes="footer-button"
                        Grid.Column="1"
                        Width="130"
                        Background="#F7F8FA"
                        BorderBrush="#C9CDD3"
                        BorderThickness="1"
                        CornerRadius="7"
                        FontSize="12"
                        FontWeight="SemiBold"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Content="ANULUJ"/>

                <Button x:Name="SaveButton"
                        Classes="footer-button"
                        Grid.Column="2"
                        Width="170"
                        CornerRadius="7"
                        FontSize="12"
                        FontWeight="Bold"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Content="DODAJ ODZIEŻ"/>

            </Grid>

        </Border>

    </Grid>

</Window>
